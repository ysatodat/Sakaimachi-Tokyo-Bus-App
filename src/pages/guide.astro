---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadTimetable } from "../lib/loadTimetable";
import { breadcrumbSchema } from "../lib/schema";
import { OFFICIAL_LINKS, PAGES, withBase } from "../lib/site";
import type { StopId } from "../lib/timetable";

const timetable = await loadTimetable();
const meta = timetable.meta;
const stops = timetable.stops;
const fares = timetable.fares;

const title = "乗車ガイド｜のりば・支払い・乗車の流れ（境町 ⇄ 東京 高速バス）";
const description =
  "境町高速バスターミナル・王子駅・東京駅八重洲南口の各のりば、支払い方法、乗車当日の流れをまとめた高速バスの乗車ガイドです。";

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "境町と東京を結ぶ高速バスの乗り方",
  description,
  totalTime: "PT10M",
  step: [
    {
      "@type": "HowToStep",
      position: 1,
      name: "のりばを確認する",
      text: "境町発は境町高速バスターミナル、東京側は東京駅八重洲南口の高速バスのりばまたは王子駅前ののりばです。"
    },
    {
      "@type": "HowToStep",
      position: 2,
      name: "発車時刻を確認する",
      text: "次発ページで出発時刻とカウントダウンを確認し、発車の5分前にはのりばに着くようにします。"
    },
    {
      "@type": "HowToStep",
      position: 3,
      name: "乗車する",
      text: "行き先を確認して乗車します。座席は先着順です。"
    },
    {
      "@type": "HowToStep",
      position: 4,
      name: "運賃を支払う",
      text: "支払い方法と運賃額は運行事業者の案内に従ってください。最新の運賃は公式サイトで確認できます。"
    }
  ]
};

const jsonLd = [
  howToSchema,
  breadcrumbSchema([
    { name: "境町 ↔ 東京 高速バス", slug: PAGES.home },
    { name: "乗車ガイド", slug: PAGES.guide }
  ])
];

const stopOrder: StopId[] = ["sakai", "oji", "tokyo"];
---

<BaseLayout
  title={title}
  description={description}
  slug={PAGES.guide}
  navKey="guide"
  ogImage="og-guide.png"
  ogImageAlt="境町⇄東京 高速バスの乗車ガイド"
  ogType="article"
  keywords={["境町 高速バス のりば", "東京駅八重洲南口 高速バスのりば", "王子駅 高速バスのりば", "境町バス 乗り方"]}
  jsonLd={jsonLd}
>
  <main id="main" class="container page">
    <div class="stack">
      <h1 style="font-size:clamp(24px,5vw,30px);">乗車ガイド</h1>
      <p class="muted" style="font-size:15px;max-width:62ch;">
        のりばの場所、支払い、当日の流れをまとめました。初めて乗る方はここだけ読めば大丈夫です。
      </p>
    </div>

    <section class="card card--padded prose" id="stops">
      <h2>のりば</h2>
      <div class="stop-grid">
        {stopOrder.map((stopId) => {
          const stop = stops[stopId];
          return (
            <div class="info-card">
              <span class="info-card__title">{stop.name}</span>
              {stop.platform && <span class="info-card__desc">{stop.platform}</span>}
              {stop.access && <span class="info-card__desc">{stop.access}</span>}
              {stop.mapUrl && (
                <a class="button button--small button--quiet" href={stop.mapUrl} target="_blank" rel="noopener noreferrer" style="justify-self:start;">
                  地図で開く <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          );
        })}
      </div>
      <p class="muted" style="font-size:13px;">
        のりばの位置は変更される場合があります。当日は現地の案内表示もあわせてご確認ください。
      </p>
    </section>

    <section class="card card--padded prose" id="fares">
      <h2>運賃・支払い</h2>
      <p>
        運賃は改定されることがあるため、本アプリでは金額を掲載していません。<strong
          >ご乗車前に運行事業者の公式ページで最新の運賃をご確認ください。</strong
        >
      </p>
      {fares?.note && <p class="muted">{fares.note}</p>}
      {fares && fares.payments.length > 0 && (
        <>
          <h3>支払い方法</h3>
          <ul>
            {fares.payments.map((payment) => (
              <li>{payment}</li>
            ))}
          </ul>
        </>
      )}
      <div class="chip-row">
        <a class="button button--primary" href={OFFICIAL_LINKS.kantetsu} target="_blank" rel="noopener noreferrer">
          関東鉄道の運賃案内 <span aria-hidden="true">↗</span>
        </a>
        <a class="button" href={OFFICIAL_LINKS.jrbus} target="_blank" rel="noopener noreferrer">
          JRバス関東 <span aria-hidden="true">↗</span>
        </a>
        <a class="button" href={OFFICIAL_LINKS.town} target="_blank" rel="noopener noreferrer">
          境町公式サイト <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="card card--padded prose" id="flow">
      <h2>乗車当日の流れ</h2>
      <ol>
        <li><a href={withBase(PAGES.home)}>次発ページ</a>で発車時刻とカウントダウンを確認します。</li>
        <li>「バス停まで徒歩何分？」を自分の所要時間に設定しておくと、間に合うかどうかが色で分かります。</li>
        <li>発車の5分前までにのりばへ。座席は先着順です。</li>
        <li>行き先表示を確認して乗車し、案内に従って運賃を支払います。</li>
        <li>降車時は忘れ物がないかご確認ください。</li>
      </ol>
      <p class="muted">
        高速道路の渋滞により到着が遅れることがあります。乗り継ぎがある場合は余裕をもった計画をおすすめします。
      </p>
    </section>

    <section class="card card--padded prose" id="tips">
      <h2>知っておくと便利なこと</h2>
      <ul>
        <li>土曜・日曜に加えて、<strong>祝日・振替休日・国民の休日も土日祝ダイヤ</strong>です。アプリが自動で判定します。</li>
        <li>境町発の便は、平日と土日祝で王子駅・東京駅への到着時刻が異なります。</li>
        <li>東京発の便は東京駅 → 王子駅 → 境町の順に停車します。王子駅から乗る場合は、のりばの切り替えで発車時刻が変わります。</li>
        <li>ホーム画面に追加しておくと、オフラインでも時刻表を確認できます。</li>
      </ul>
      <p class="muted" style="font-size:13px;">
        本ページの情報は{meta.revisionLabel}時点の公開情報にもとづく参考情報です。最新の内容は公式サイトでご確認ください。
      </p>
    </section>

    <section class="callout">
      <h2 style="font-size:16px;">あわせて読みたい</h2>
      <ul class="prose" style="padding-left:1.25em;">
        <li><a href={withBase(PAGES.timetable)}>全便時刻表（平日・土日祝）</a></li>
        <li><a href={withBase(PAGES.faq)}>よくある質問</a></li>
        <li><a href={withBase(PAGES.sakaiToTokyo)}>境町 → 東京 の次発</a></li>
        <li><a href={withBase(PAGES.tokyoToSakai)}>東京 → 境町 の次発</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
