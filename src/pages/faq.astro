---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadTimetable } from "../lib/loadTimetable";
import { breadcrumbSchema, faqSchema } from "../lib/schema";
import { OFFICIAL_LINKS, PAGES, SITE, withBase } from "../lib/site";

const timetable = await loadTimetable();
const meta = timetable.meta;

const title = "よくある質問｜境町 ⇄ 東京 高速バス ミニ";
const description =
  "境町と東京（王子駅・東京駅）を結ぶ高速バスの利用や、本アプリの使い方についてのよくある質問。祝日ダイヤ、オフライン利用、データの更新方針などをまとめています。";

const faqs = [
  {
    question: "平日ダイヤと土日祝ダイヤは自動で切り替わりますか？",
    answer:
      "はい。土曜・日曜に加えて、国民の祝日・振替休日・国民の休日も土日祝ダイヤとして自動判定します。祝日カレンダーはアプリに内蔵しているため、オフラインでも正しく判定されます。"
  },
  {
    question: "表示されている時刻はリアルタイムの運行情報ですか？",
    answer:
      "いいえ。公開されている時刻表をもとにした固定のダイヤです。渋滞や運休などの当日の運行状況は反映されません。遅延が気になるときは運行事業者の公式サイトをご確認ください。"
  },
  {
    question: "時刻表データはいつのものですか？",
    answer: `${meta.revisionLabel}のダイヤをもとにしています。${
      meta.pendingRevision
        ? `なお ${meta.pendingRevision.label} が告知されており、アプリのデータはまだ改定前の内容です。ご乗車前に公式の時刻表をあわせてご確認ください。`
        : ""
    }`
  },
  {
    question: "「バス停まで徒歩何分？」は何に使われますか？",
    answer:
      "入力した徒歩時間をもとに、次の便に間に合うかどうかを「間に合います／そろそろ出発／急いでください」の3段階で表示します。設定は端末内に保存され、次回以降も引き継がれます。"
  },
  {
    question: "カレンダーに追加すると何が登録されますか？",
    answer:
      "選んだ便の乗車時刻から到着時刻までの予定を、.ics ファイルとして書き出します。設定した徒歩時間＋5分前にアラームが鳴るよう設定されているので、出発の準備に使えます。端末のカレンダーアプリで開いて登録してください。"
  },
  {
    question: "ホーム画面に追加して使えますか？ オフラインでも見られますか？",
    answer:
      "はい。iOS は Safari の共有メニューから「ホーム画面に追加」、Android は Chrome のメニューから「ホーム画面に追加」を選んでください。一度表示したページはキャッシュされるため、電波の届かない場所でも時刻表を確認できます。"
  },
  {
    question: "東京から乗るとき、東京駅と王子駅のどちらを基準に表示できますか？",
    answer:
      "どちらも選べます。「東京 → 境町」を選んだあと、乗車する停留所を切り替えると、その停留所の発車時刻を基準に次発とカウントダウンが表示されます。"
  },
  {
    question: "運賃はいくらですか？",
    answer:
      "運賃は改定されることがあるため、本アプリでは金額を掲載していません。最新の運賃は運行事業者（関東鉄道・JRバス関東）および境町公式サイトでご確認ください。"
  },
  {
    question: "ダイヤの誤りを見つけたときは？",
    answer:
      "GitHub の Issue またはフッターのリンクからお知らせください。公式の時刻表と突き合わせたうえで修正します。"
  }
];

const jsonLd = [
  faqSchema(faqs),
  breadcrumbSchema([
    { name: "境町 ↔ 東京 高速バス", slug: PAGES.home },
    { name: "よくある質問", slug: PAGES.faq }
  ])
];
---

<BaseLayout
  title={title}
  description={description}
  slug={PAGES.faq}
  navKey="faq"
  ogImage="og-faq.png"
  ogImageAlt="境町⇄東京 高速バスのよくある質問"
  ogType="article"
  keywords={["境町 高速バス FAQ", "境町バス 祝日ダイヤ", "高速バス よくある質問"]}
  jsonLd={jsonLd}
>
  <main id="main" class="container page">
    <div class="stack">
      <h1 style="font-size:clamp(24px,5vw,30px);">よくある質問</h1>
      <p class="muted" style="font-size:15px;max-width:62ch;">
        高速バスの利用と本アプリの使い方について、よく寄せられる質問をまとめました。
      </p>
    </div>

    <div class="faq-list">
      {faqs.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <div class="faq-item__body">{item.answer}</div>
        </details>
      ))}
    </div>

    <section class="callout">
      <h2 style="font-size:16px;">解決しないときは</h2>
      <ul class="prose" style="padding-left:1.25em;">
        <li><a href={withBase(PAGES.guide)}>乗車ガイド</a>でのりばや乗車の流れを確認する</li>
        <li><a href={withBase(PAGES.timetable)}>全便時刻表</a>で当日のダイヤを確認する</li>
        <li>
          <a href={OFFICIAL_LINKS.town} target="_blank" rel="noopener noreferrer">境町公式サイト</a>
          で運行状況・運賃の最新情報を確認する
        </li>
        <li>
          <a
            href={`${SITE.repository}/issues/new?template=bug_report.yml`}
            target="_blank"
            rel="noopener noreferrer">不具合・ご要望を報告する</a
          >
        </li>
      </ul>
    </section>
  </main>
</BaseLayout>
