---
import BaseLayout from "../layouts/BaseLayout.astro";
import BoardView from "../components/BoardView.astro";
import { loadTimetable } from "../lib/loadTimetable";
import { breadcrumbSchema, routeSchema } from "../lib/schema";
import { PAGES } from "../lib/site";

const timetable = await loadTimetable();

const title = "境町 → 東京 高速バスの時刻表・次発｜境町バスミニ";
const description =
  "境町高速バスターミナルから王子駅・東京駅へ向かう高速バスの次の便・全便の時刻表。平日／土日祝ダイヤを祝日も含めて自動判定します。";

const jsonLd = [
  breadcrumbSchema([
    { name: "境町 ↔ 東京 高速バス", slug: PAGES.home },
    { name: "境町 → 東京 時刻表", slug: PAGES.sakaiToTokyo }
  ]),
  routeSchema(timetable, "sakai_to_tokyo")
].filter(Boolean);
---

<BaseLayout
  title={title}
  description={description}
  slug={PAGES.sakaiToTokyo}
  navKey="sakai-to-tokyo"
  ogImage="og-sakai-to-tokyo.png"
  ogImageAlt="境町発 東京行き高速バスの次発案内"
  keywords={["境町 東京 バス", "境町 王子駅 高速バス", "境町バスターミナル 東京", "境町 東京駅 高速バス"]}
  jsonLd={jsonLd}
>
  <BoardView
    timetable={timetable}
    heading="境町 → 東京 の次の便"
    lead="境町高速バスターミナルから王子駅・東京駅八重洲南口へ向かう便です。到着時刻は平日と土日祝で異なります。"
    direction="sakai_to_tokyo"
    boardStop="sakai"
    lockDirection
  />
</BaseLayout>
