---
import BaseLayout from "../layouts/BaseLayout.astro";
import BoardView from "../components/BoardView.astro";
import { loadTimetable } from "../lib/loadTimetable";
import { breadcrumbSchema, routeSchema, webApplicationSchema } from "../lib/schema";
import { PAGES } from "../lib/site";

const timetable = await loadTimetable();

const title = "境町 ↔ 東京 高速バス｜次の便と時刻表（王子駅・東京駅）";
const description =
  "境町高速バスターミナルと王子駅・東京駅を結ぶ高速バスの「次に出発する便」を、開いた瞬間に表示します。平日／土日祝ダイヤと祝日を自動判定。全便の時刻表つき。";

const jsonLd = [
  webApplicationSchema(description),
  breadcrumbSchema([{ name: "境町 ↔ 東京 高速バス", slug: PAGES.home }]),
  routeSchema(timetable, "sakai_to_tokyo"),
  routeSchema(timetable, "tokyo_to_sakai")
].filter(Boolean);
---

<BaseLayout
  title={title}
  description={description}
  slug={PAGES.home}
  navKey="home"
  keywords={[
    "境町 高速バス",
    "境町 東京 バス",
    "王子駅 高速バス",
    "東京駅 高速バス",
    "境町バスターミナル",
    "高速バス 時刻表"
  ]}
  jsonLd={jsonLd}
>
  <BoardView
    timetable={timetable}
    heading="次に出発する便"
    lead="境町と東京（王子駅・東京駅）を結ぶ高速バスの時刻を、開いた瞬間に確認できます。平日／土日祝ダイヤは祝日カレンダーを含めて自動で切り替わります。"
    direction="sakai_to_tokyo"
    staticRoutes={["sakai_to_tokyo", "tokyo_to_sakai"]}
  />
</BaseLayout>
