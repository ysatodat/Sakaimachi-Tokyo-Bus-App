---
import BaseLayout from "../layouts/BaseLayout.astro";
import BoardView from "../components/BoardView.astro";
import { loadTimetable } from "../lib/loadTimetable";
import { breadcrumbSchema, routeSchema } from "../lib/schema";
import { PAGES } from "../lib/site";

const timetable = await loadTimetable();

const title = "東京 → 境町 高速バスの時刻表・次発｜境町バスミニ";
const description =
  "東京駅八重洲南口・王子駅から境町へ向かう高速バスの次の便・全便の時刻表。乗車するのりばを選ぶと発車時刻がその停留所基準に切り替わります。";

const jsonLd = [
  breadcrumbSchema([
    { name: "境町 ↔ 東京 高速バス", slug: PAGES.home },
    { name: "東京 → 境町 時刻表", slug: PAGES.tokyoToSakai }
  ]),
  routeSchema(timetable, "tokyo_to_sakai")
].filter(Boolean);
---

<BaseLayout
  title={title}
  description={description}
  slug={PAGES.tokyoToSakai}
  navKey="tokyo-to-sakai"
  ogImage="og-tokyo-to-sakai.png"
  ogImageAlt="東京発 境町行き高速バスの次発案内"
  keywords={["東京 境町 バス", "王子駅 境町 高速バス", "東京駅 高速バス 境町", "境町行き 高速バス"]}
  jsonLd={jsonLd}
>
  <BoardView
    timetable={timetable}
    heading="東京 → 境町 の次の便"
    lead="東京駅八重洲南口・王子駅から境町高速バスターミナルへ向かう便です。乗車する停留所を切り替えると、その停留所の発車時刻で表示します。"
    direction="tokyo_to_sakai"
    boardStop="tokyo"
    lockDirection
  />
</BaseLayout>
